# DeepSeek (兼容 OpenAI SDK，调 deepseek-chat / V3)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# fal.ai (调字节即梦 / Seedream)
# FAL_KEY 在 https://fal.ai/dashboard/keys 申请
FAL_KEY=
# FAL_MODEL 填 fal.ai 上即梦模型的 endpoint id（以 fal.ai 文档实际为准）
FAL_MODEL=fal-ai/bytedance/seedream/v4.5/text-to-image
# FAL_IMAGE_SIZE 取值: square_hd / square / portrait_4_3 / portrait_16_9 /
#   landscape_4_3 / landscape_16_9 / auto_2K / auto_4K（portrait_16_9 为最竖的竖图）
FAL_IMAGE_SIZE=portrait_16_9
